# منفذ الخادم
PORT=3000

# مفسّر بايثون (ويندوز: py أو python)
PYTHON_BIN=python3

# محرك الصوت
TTS_CONCURRENCY=4
TTS_TIMEOUT_MS=240000

# سياسة الاحتفاظ بالملفات
CACHE_TTL_DAYS=14
OUT_RETENTION_DAYS=7

# طابور التوليد
QUEUE_CONCURRENCY=2
QUEUE_MAX_JOBS=80

# حماية الوصول (اتركها فارغة محلياً — إلزامية عند النشر العام)
APP_USER=admin
APP_PASSWORD=
